{
  "item": [
    {
      "id": "85267365-a1d1-4de9-983c-67144e498164",
      "name": "Tokens",
      "description": {
        "content": "ERC-20 and ERC-721 token balances, supply, and holder lists",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "baa6f9e7-cde7-4687-9380-557bb580bed5",
          "name": "Call an API module action",
          "request": {
            "name": "Call an API module action",
            "description": {
              "content": "All Optimism Etherscan API calls are issued against this endpoint. The `module` and `action` query parameters select the operation; additional parameters depend on the module/action pair. For V2 unified access, also pass `chainid=10`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "module",
                  "value": "<string>",
                  "description": "(Required) API module name. One of: account, contract, transaction, block, logs, token, stats, proxy."
                },
                {
                  "disabled": false,
                  "key": "action",
                  "value": "<string>",
                  "description": "(Required) Action to perform within the selected module. Examples: balance, txlist, tokentx, getabi, getsourcecode, getstatus, getblockreward, tokensupply, ethsupply, gasoracle, eth_blockNumber."
                },
                {
                  "disabled": false,
                  "key": "chainid",
                  "value": "<integer>",
                  "description": "Chain ID for Etherscan V2 unified endpoint. Use 10 for OP Mainnet. Not needed when using the legacy api-optimistic.etherscan.io endpoint."
                },
                {
                  "disabled": false,
                  "key": "address",
                  "value": "<string>",
                  "description": "OP Mainnet address for account or token operations (0x-prefixed)."
                },
                {
                  "disabled": false,
                  "key": "contractaddress",
                  "value": "<string>",
                  "description": "Smart contract address for token or contract operations (0x-prefixed)."
                },
                {
                  "disabled": false,
                  "key": "txhash",
                  "value": "<string>",
                  "description": "Transaction hash for transaction-level queries."
                },
                {
                  "disabled": false,
                  "key": "blockno",
                  "value": "<integer>",
                  "description": "Block number for block-level queries."
                },
                {
                  "disabled": false,
                  "key": "startblock",
                  "value": "<integer>",
                  "description": "Start block for range queries (inclusive)."
                },
                {
                  "disabled": false,
                  "key": "endblock",
                  "value": "<integer>",
                  "description": "End block for range queries (inclusive). Use 99999999 for latest."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "Page number for paginated results (default 1)."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<integer>",
                  "description": "Number of results per page (max 10000)."
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "<string>",
                  "description": "Sort direction for list results."
                },
                {
                  "disabled": false,
                  "key": "tag",
                  "value": "<string>",
                  "description": "Block tag for proxy/stats calls. One of: latest, earliest, pending, or a hex block number."
                },
                {
                  "disabled": false,
                  "key": "boolean",
                  "value": "<string>",
                  "description": "Used with module=account&action=balance for multi-address balance queries. Set to true to enable."
                },
                {
                  "disabled": false,
                  "key": "apikey",
                  "value": "<string>",
                  "description": "Etherscan API key. Required for most endpoints; obtain at https://optimistic.etherscan.io/myapikey. Can also be passed via the apiKeyAuth security scheme."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
